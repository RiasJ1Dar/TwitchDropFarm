env/
build/
dist/
# теки перевірочних збірок: dist-ctk, dist-rel, build-check…
# `dist/` їх не покриває, і 22-мегабайтний .exe одного разу вже потрапив у коміт
dist-*/
build-*/
__pycache__/
*.py[cod]
.ruff_cache/
auth.json
cookies.jar
settings.json
lock.file
log.txt
browser_profile/
portable.txt

# Робочі нотатки — не для публікації
HANDOFF.md
IDEAS.md
MANIFEST_PUBLIC_KEY.txt

# Obsidian: тека проєкту підключена до сховища через junction
.obsidian/

# Вихід перевірки схем: знімки в двох темах і звіт. Породжується заново
# на кожному прогоні, у репозиторії потрібна лише сама схема.
docs/*.visual-check.*
docs/*.vcheck-out.txt

# Квитанції archify містять абсолютні локальні шляхи: у git лише HTML і candidate.json
*.finalize.json
*.finalize-summary.json
*.delivery.json
*.browser-check.json
*.visual-check.*
review-*/
visual-check/
