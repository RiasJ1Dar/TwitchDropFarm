  "cards": [
    {
      "dot": "cyan",
      "title": "Module boundaries",
      "items": [
        "The miner holds decision logic only: what to watch and when to switch",
        "Networking lives in api, subscriptions in pubsub, the model in model",
        "The miner knows nothing about headers or the interface"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "One .exe with no separate runtime, built with PyInstaller",
        "The Windows console is switched to UTF-8 before the first log line",
        "Tray and Telegram drive the same miner"
      ]
    },
    {
      "dot": "rose",
      "title": "Access and resilience",
      "items": [
        "Authorization uses the OAuth device flow for the Android client, not stolen cookies",
        "Token and cookies sit in the state directory next to the config",
        "Twitch caps topics per connection, so the pool opens and collapses connections itself",
        "GraphQL requests are throttled to 5 per second"
      ]
    }
  ]
